#!/usr/bin/env bash
# Shared boot/pop launcher. ROLES_TOML selects the project manifest.
# AGENT_LAUNCH_DRYRUN=1 prints a plan without executing a client or writing files.
# exec keeps this pid all the way to the client: `agentbus roles launch` binds it, then execs.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/roles.sh"
exec "$AGENTBUS_BIN" roles launch "$@"
