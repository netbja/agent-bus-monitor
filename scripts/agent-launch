#!/usr/bin/env bash
# Shared boot/pop launcher. ROLES_TOML selects the project manifest.
# AGENT_LAUNCH_DRYRUN=1 prints a plan without executing a client or writing files.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$SCRIPT_DIR/lib/role_config.py" launch "$@"
