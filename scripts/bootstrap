#!/usr/bin/env bash
# Provision (do NOT launch) a project's Agent Bus team. Opening the workspace is the human's
# job via the herdr-plus fuzzy picker; this only writes the template + prepares the broker.
# Usage:
#   bootstrap [new|recall] <project> [--index] [--cron] [--yes]
#   bootstrap <project> ...           # no verb -> auto: recall if the template exists, else new
# Env seam: HERDR_PLUS_PROJECTS_DIR (default resolved from herdr).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/roles.sh"

die()  { echo "bootstrap: $*" >&2; exit 1; }
warn() { echo "bootstrap: $*" >&2; }

verb=""; project=""; project_dir=""; session_flag=""; do_index=0; do_cron=0; assume_yes=0
want_session=0
for a in "$@"; do
  if [[ "$want_session" == 1 ]]; then session_flag="$a"; want_session=0; continue; fi
  case "$a" in
    new|recall) verb="$a" ;;
    --session)  want_session=1 ;;
    --index)    do_index=1 ;;
    --cron)     do_cron=1 ;;
    --yes|-y)   assume_yes=1 ;;
    -*)         die "unknown flag: $a" ;;
    *)          if [[ -z "$project" ]]; then project="$a";
                elif [[ -z "$project_dir" ]]; then project_dir="$a";
                else die "unexpected arg: $a"; fi ;;
  esac
done
[[ "$want_session" == 0 ]] || die "--session needs a value"
[[ -n "$project" ]] || die "usage: bootstrap [new|recall] <project> [<path>] [--session <name>] [--index] [--cron] [--yes]"
[[ "$project" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid project name: $project"

# The team's working directory: where every agent's cwd lands, and where --index builds the
# index + drops the sentinel marker. Defaults to $PWD (run bootstrap from your project), or pass
# it as the 2nd positional. NOT the tooling repo — that stays $REPO (broker, agent-launch, busmon).
project_dir="${project_dir:-$PWD}"
[[ -d "$project_dir" ]] || die "project path is not a directory: $project_dir"
PROJECT_DIR="$(cd "$project_dir" && pwd)"

# The herdr session the project opens in (herdr registers plugins PER SESSION). --session wins,
# else the session bootstrap runs inside ($HERDR_SESSION), else the project name (the convention).
SESSION="${session_flag:-${HERDR_SESSION:-$project}}"
HERDR_PLUS_PATH="${HERDR_PLUS_PATH:-$HOME/Tools/herdr-plugins/herdr-plus}"

projects_dir() {
  if [[ -n "${HERDR_PLUS_PROJECTS_DIR:-}" ]]; then echo "$HERDR_PLUS_PROJECTS_DIR"; return; fi
  local base
  if base="$(herdr plugin config-dir cloudmanic.herdr-plus 2>/dev/null)" && [[ -n "$base" ]]; then
    echo "$base/projects"
  else
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/herdr-plus/projects"
  fi
}
PROJECTS_DIR="$(projects_dir)"
template="$PROJECTS_DIR/$project.toml"

if [[ -z "$verb" ]]; then
  if [[ -f "$template" ]]; then verb="recall"; else verb="new"; fi
fi

ensure_broker() {
  ( cd "$REPO" && docker compose up -d ) || die "failed to start the broker (docker compose up -d)"
}

write_template() {
  mkdir -p "$PROJECTS_DIR"
  {
    echo "name = \"$project\""
    echo "description = \"Agent Bus team for $project\""
    echo "working_dir = \"$PROJECT_DIR\""
    echo
    while IFS= read -r role; do
      echo "[[tabs]]"
      echo "name = \"$role\""
      echo "command = \"$SCRIPT_DIR/agent-launch $role $project\""
      echo
    done < <(roles_by_tier boot)
    echo "[[tabs]]"
    echo "name = \"busmon\""
    echo "command = \"$REPO/busmon --project $project\""
  } > "$template"
  echo "wrote $template"
}

index_preflight() {
  if command -v rtk >/dev/null 2>&1; then echo "rtk: $(command -v rtk)"; else warn "rtk not on PATH (token proxy inactive; non-fatal)"; fi
  if [[ -d "$PROJECT_DIR/.codegraph" ]]; then
    echo "codegraph: index already present (.codegraph/)"
  elif command -v codegraph >/dev/null 2>&1; then
    if ( cd "$PROJECT_DIR" && codegraph init ); then echo "codegraph: initialized"; else warn "codegraph init failed (non-fatal; agents fall back to grep/Read)"; fi
  else
    warn "codegraph not on PATH (skipping index; non-fatal)"
  fi
  # Signal the sentinel (whose cwd is the project) to warm the code-index on its next boot.
  mkdir -p "$PROJECT_DIR/.agent-bus" && : > "$PROJECT_DIR/.agent-bus/index-requested"
  # keep the marker out of the project's git status
  if [[ -f "$PROJECT_DIR/.gitignore" ]] && ! grep -qxF '.agent-bus/' "$PROJECT_DIR/.gitignore"; then
    printf '\n# agent-bus local markers\n.agent-bus/\n' >> "$PROJECT_DIR/.gitignore"
  fi
  echo "index: requested (sentinel runs index_repository on boot)"
}
install_cron() {
  local session="${HERDR_SESSION:-default}"
  local tag="# agent-bus daily-review: $project"
  local line="0 7 * * * AGENT_BUS_PROJECT=$project HERDR_SESSION=$session $SCRIPT_DIR/daily-review-trigger.sh >/dev/null 2>&1"
  local current; current="$(crontab -l 2>/dev/null || true)"
  # -x: whole-line match, so project "demo" is not seen as "installed" merely because
  # "# agent-bus daily-review: demo2" already exists (substring collision).
  if grep -qxF "$tag" <<<"$current"; then
    echo "cron: already installed for $project"
    return
  fi
  printf '%s\n%s\n%s\n' "$current" "$tag" "$line" | grep -v '^[[:space:]]*$' | crontab -
  echo "cron: installed daily-review for $project (07:00 daily)"
}

# `herdr plugin link` REGISTERS the plugin, it does not COMPILE it — and every entry point spawns
# ./bin/herdr-plus. Build it here when it's missing, so a fresh machine doesn't discover the gap as
# "Unable to spawn … bin/herdr-plus … does not exist" at the first pane-open. Prefers the plugin
# manifest's own [[build]] script, falls back to the Makefile target. Best-effort: a failed build
# only warns — linking an unbuilt plugin is no worse than not linking it.
ensure_plugin_built() {
  if [[ -x "$HERDR_PLUS_PATH/bin/herdr-plus" ]]; then return 0; fi
  local how=""
  if   [[ -f "$HERDR_PLUS_PATH/scripts/build.sh" ]]; then how="sh scripts/build.sh"
  elif [[ -f "$HERDR_PLUS_PATH/Makefile"        ]]; then how="make build"
  else warn "herdr-plus: no bin/herdr-plus and no build script at $HERDR_PLUS_PATH; the Projects picker will not open"; return 0
  fi
  echo "herdr-plus: binary missing — building ($how)"
  if ! ( cd "$HERDR_PLUS_PATH" && $how ); then
    warn "herdr-plus build failed ($how); build it by hand before using the Projects picker"
    return 0
  fi
  if [[ -x "$HERDR_PLUS_PATH/bin/herdr-plus" ]]; then echo "herdr-plus: built"
  else warn "herdr-plus: $how produced no bin/herdr-plus"; fi
  return 0
}

# Register herdr-plus in the target session so the Projects picker works there — herdr registers
# plugins per session, so a fresh project session starts without it. Best-effort: skip cleanly if
# herdr or the plugin checkout is missing. Works whether the session is running (registers live) or
# not (seeds its registry for the next `herdr --session <name>`).
link_plugin() {
  command -v herdr >/dev/null 2>&1 || { warn "herdr not on PATH; skipping herdr-plus link"; return 0; }
  [[ -d "$HERDR_PLUS_PATH" ]] || { warn "herdr-plus not at $HERDR_PLUS_PATH; skipping link (set HERDR_PLUS_PATH)"; return 0; }
  ensure_plugin_built
  if HERDR_SESSION="$SESSION" herdr plugin link "$HERDR_PLUS_PATH" >/dev/null 2>&1; then
    echo "herdr-plus: linked into session '$SESSION' (open the Projects picker there)"
  else
    # herdr only registers into a RUNNING session server; if '$SESSION' isn't up this is expected.
    warn "herdr-plus not linked into '$SESSION' — is that session running? Start it ('herdr --session $SESSION') then re-run bootstrap from inside it."
  fi
}

case "$verb" in
  new)
    ensure_broker
    "$SCRIPT_DIR/link-role-skills.sh"
    write_template
    ;;
  recall)
    ensure_broker
    [[ -f "$template" ]] || warn "no template at $template (run 'bootstrap new $project')"
    echo "recall: broker up; open '$project' via the herdr-plus picker (fresh sessions)"
    ;;
esac
link_plugin
[[ "$do_index" == "1" ]] && index_preflight
[[ "$do_cron"  == "1" ]] && install_cron
echo "bootstrap: $verb $project done"
