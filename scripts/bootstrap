#!/usr/bin/env bash
# Provision (do NOT launch) a project's Agent Bus team. Opening the workspace is `agentbus up <p>`
# or the Projects picker (prefix+up); this only writes the template + prepares the broker.
# Usage:
#   bootstrap [new|recall] <project> [<path>] [--session <name>] [--as <your-name>] [--index] [--cron] [--no-dispatch] [--no-missions] [--yes]
#   bootstrap <project> ...           # no verb -> auto: recall if the template exists, else new
# The template opens one tab per boot role, a busmon tab, (unless --no-dispatch) a dispatch tab
# running `agentbus --project <p> dispatch`, which wakes idle unarmed agents when work lands for
# them, and (unless --no-missions) a missions tab running the conductor on the project dir.
# Env seam: AGENTBUS_PROJECTS_DIR (default ~/.config/agentbus/projects, via agentbus roles projects-dir).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/roles.sh"

die()  { echo "bootstrap: $*" >&2; exit 1; }
warn() { echo "bootstrap: $*" >&2; }

verb=""; project=""; project_dir=""; session_flag=""; do_index=0; do_cron=0; assume_yes=0; busmon_as=""; want_as=0
do_dispatch=1
do_missions=1
want_session=0
for a in "$@"; do
  if [[ "$want_session" == 1 ]]; then session_flag="$a"; want_session=0; continue; fi
  if [[ "$want_as" == 1 ]]; then busmon_as="$a"; want_as=0; continue; fi
  case "$a" in
    new|recall) verb="$a" ;;
    --session)  want_session=1 ;;
    --as)       want_as=1 ;;
    --index)    do_index=1 ;;
    --cron)     do_cron=1 ;;
    --no-dispatch) do_dispatch=0 ;;
    --no-missions) do_missions=0 ;;
    --yes|-y)   assume_yes=1 ;;
    -*)         die "unknown flag: $a" ;;
    *)          if [[ -z "$project" ]]; then project="$a";
                elif [[ -z "$project_dir" ]]; then project_dir="$a";
                else die "unexpected arg: $a"; fi ;;
  esac
done
[[ "$want_session" == 0 ]] || die "--session needs a value"
[[ "$want_as" == 0 ]] || die "--as needs a name"
[[ -z "$busmon_as" || "$busmon_as" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid --as name: $busmon_as (lowercase, as on the bus)"
[[ -n "$project" ]] || die "usage: bootstrap [new|recall] <project> [<path>] [--session <name>] [--as <your-name>] [--index] [--cron] [--no-dispatch] [--no-missions] [--yes]"
[[ "$project" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid project name: $project"

# The team's working directory: where every agent's cwd lands, and where --index builds the
# index + drops the sentinel marker. Defaults to $PWD (run bootstrap from your project), or pass
# it as the 2nd positional. NOT the tooling repo — that stays $REPO (broker, agent-launch, busmon).
project_dir="${project_dir:-$PWD}"
[[ -d "$project_dir" ]] || die "project path is not a directory: $project_dir"
PROJECT_DIR="$(cd "$project_dir" && pwd)"

# --session (session_flag) is only accepted: `agentbus up` passes its flags on and resolves the
# session itself. Plugins are no business of bootstrap: setup.sh links agent-bus once, globally.

PROJECTS_DIR="$("$AGENTBUS_BIN" roles projects-dir)" || die "cannot resolve the templates directory (agentbus roles projects-dir)"
template="$PROJECTS_DIR/$project.toml"

if [[ -z "$verb" ]]; then
  if [[ -f "$template" ]]; then verb="recall"; else verb="new"; fi
fi

ensure_broker() {
  ( cd "$REPO" && docker compose up -d ) || die "failed to start the broker (docker compose up -d)"
}

write_template() {
  mkdir -p "$PROJECTS_DIR"
  "$AGENTBUS_BIN" roles template "$project" "$PROJECT_DIR" "$SCRIPT_DIR" "$REPO" "$do_dispatch" "$do_missions" ${busmon_as:+"$busmon_as"} > "$template" \
    || die "failed to write $template"
  echo "wrote $template"
}

index_preflight() {
  if command -v rtk >/dev/null 2>&1; then echo "rtk: $(command -v rtk)"; else warn "rtk not on PATH (token proxy inactive; non-fatal)"; fi
  if [[ -d "$PROJECT_DIR/.codegraph" ]]; then
    echo "codegraph: index already present (.codegraph/)"
  elif command -v codegraph >/dev/null 2>&1; then
    if ( cd "$PROJECT_DIR" && codegraph init ); then echo "codegraph: initialized"; else warn "codegraph init failed (non-fatal; agents fall back to grep/Read)"; fi
  else
    warn "codegraph not on PATH (skipping index; non-fatal)"
  fi
  # Signal the sentinel (whose cwd is the project) to warm the code-index on its next boot.
  mkdir -p "$PROJECT_DIR/.agent-bus" && : > "$PROJECT_DIR/.agent-bus/index-requested"
  # keep the marker out of the project's git status
  if [[ -f "$PROJECT_DIR/.gitignore" ]] && ! grep -qxF '.agent-bus/' "$PROJECT_DIR/.gitignore"; then
    printf '\n# agent-bus local markers\n.agent-bus/\n' >> "$PROJECT_DIR/.gitignore"
  fi
  echo "index: requested (sentinel runs index_repository on boot)"
}
install_cron() {
  local session="${HERDR_SESSION:-default}"
  local tag="# agent-bus daily-review: $project"
  local line="0 7 * * * AGENT_BUS_PROJECT=$project HERDR_SESSION=$session $SCRIPT_DIR/daily-review-trigger.sh >/dev/null 2>&1"
  local current; current="$(crontab -l 2>/dev/null || true)"
  # -x: whole-line match, so project "demo" is not seen as "installed" merely because
  # "# agent-bus daily-review: demo2" already exists (substring collision).
  if grep -qxF "$tag" <<<"$current"; then
    echo "cron: already installed for $project"
    return
  fi
  printf '%s\n%s\n%s\n' "$current" "$tag" "$line" | grep -v '^[[:space:]]*$' | crontab -
  echo "cron: installed daily-review for $project (07:00 daily)"
}

roles_validate || die "invalid role manifest"

case "$verb" in
  new)
    ensure_broker
    "$SCRIPT_DIR/link-role-skills.sh" --missing-ok   # a missing skill warns: the agent starts without it
    write_template
    ;;
  recall)
    ensure_broker
    [[ -f "$template" ]] || warn "no template at $template (run 'bootstrap new $project')"
    # agentbus up runs this itself (AGENTBUS_UP): it is not told to run agentbus up
    [[ -n "${AGENTBUS_UP:-}" ]] || echo "recall: broker up; open '$project' with agentbus up $project, or prefix+up (the Projects picker)"
    ;;
esac
[[ "$do_index" == "1" ]] && index_preflight
[[ "$do_cron"  == "1" ]] && install_cron
echo "bootstrap: $verb $project done"
