#!/usr/bin/env bash
# The master's "pop": open a new herdr tab that runs agent-launch <role> <project>.
# Requires HERDR_ENV=1 (you must be inside herdr to drive it) — same precondition as the
# agent-bus-master skill. Reuses the exact boot recipe (agent-launch), so pop == boot.
# Usage: agent-spawn <role> <project> [--profile <profile>]
#   --profile launches the role on another profile of ROLES_TOML (agentbus swap, v0.15).
#   AGENT_LAUNCH_REQUIRE_BIND=1 is passed on: the launch fails if it cannot bind its pane.
#   AGENT_SPAWN_DRYRUN=1 -> print the herdr command instead of running it (test seam).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/roles.sh"

die() { echo "agent-spawn: $*" >&2; exit 1; }

role="${1:?usage: agent-spawn <role> <project> [--profile <profile>]}"
project="${2:?usage: agent-spawn <role> <project> [--profile <profile>]}"
profile=""
if [[ $# -gt 2 ]]; then
  [[ $# -eq 4 && "$3" == "--profile" ]] || die "usage: agent-spawn <role> <project> [--profile <profile>]"
  profile="$4"
  [[ "$profile" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid profile name"
fi

[[ "${HERDR_ENV:-}" == "1" ]] || die "not inside herdr (HERDR_ENV != 1); open via the herdr-plus picker instead"
[[ "$project" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid project name"
role_exists "$role" || die "unknown role: $role"
roles_validate || die "invalid role manifest"

# v0.17: an agent pops a role marked approval = "person" only with a person's approval on the
# bus, spent here (a swap hands over the one it spent). A person's own shell is not gated.
if [[ -n "${AGENT_BUS_AGENT:-}" && "$(role_field "$role" approval)" == person ]]; then
  use=(approval use "$role")
  [[ -n "${AGENT_SPAWN_APPROVAL:-}" ]] && use+=(--by-swap "$AGENT_SPAWN_APPROVAL")
  "$AGENTBUS_BIN" --project "$project" "${use[@]}" >/dev/null || die "$role needs a person's approval: agentbus approval ask $role <reason>, then wait for the answer in busmon"
fi

# The command that turns a pane into the agent (exec so the pane *becomes* it, like the boot tabs).
envs=("ROLES_TOML=$ROLES_TOML")
[[ "${AGENT_LAUNCH_REQUIRE_BIND:-}" == "1" ]] && envs+=("AGENT_LAUNCH_REQUIRE_BIND=1")
args=("$SCRIPT_DIR/agent-launch" "$role" "$project")
[[ -n "$profile" ]] && args+=(--profile "$profile")
printf -v launch 'exec env'
for w in "${envs[@]}" "${args[@]}"; do printf -v launch '%s %q' "$launch" "$w"; done

if [[ "${AGENT_SPAWN_DRYRUN:-0}" == "1" ]]; then
  # `herdr agent start` (the old recipe) split the current pane; a popped agent should get its
  # own TAB like the boot agents. So: create a tab, then run the launch leaf in its root pane.
  printf 'herdr tab create --label %s --cwd %s --no-focus\n' "$role" "$PWD"
  printf 'herdr pane run <new-tab-root-pane> %s\n' "$launch"
  exit 0
fi

# Open a NEW TAB in the current workspace (not a split), grab its root pane, run the leaf there.
tab_json="$(herdr tab create --label "$role" --cwd "$PWD" --no-focus)"
pane="$(printf '%s' "$tab_json" | tr -d '\n' | sed -n 's/.*"root_pane":[[:space:]]*{[^}]*"pane_id":[[:space:]]*"\([^"]*\)".*/\1/p')"
[[ -n "$pane" ]] || die "could not resolve the new tab's pane id from herdr: $tab_json"
herdr pane run "$pane" "$launch"
echo "agent-spawn: $role launched in a new tab (pane $pane)"
